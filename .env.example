# Copy to .env (git-ignored) and fill in. The backend reads this file automatically.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey), used for photo auto-fill
GEMINI_API_KEY=

# Admin account created at startup
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-password
ADMIN_NAME=Your Name
# Emails that become ADMIN when signing in with a verified Google account
ADMIN_EMAILS=you@example.com

# Secret that signs session tokens. Generate one: openssl rand -base64 48
AUTH_TOKEN_SECRET=

# Optional: your own Google OAuth client ID (Google Sign-In)
# GOOGLE_CLIENT_ID=
